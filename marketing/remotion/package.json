{
  "name": "qualiconnect-marketing-video",
  "version": "1.0.0",
  "private": true,
  "description": "90-second vertical (9:16) sales video for QualiConnect — pure Remotion, no screenshots.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "video": "remotion render src/index.ts QualiConnect out/qualiconnect.mp4",
