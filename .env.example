# ============================================
# QualiEvents Configuration
# Generated by install.sh
# ============================================

# Deploy mode: "onpremise" or "saas"
DEPLOY_MODE="saas"

# Database (PostgreSQL)
# DATABASE_URL: pooled connection used at runtime (Supabase Transaction pooler, port 6543)
# DIRECT_URL:   direct connection used by `prisma migrate` only (port 5432)
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Vercel Blob — get from Vercel dashboard → Storage → Blob → Connect
BLOB_READ_WRITE_TOKEN=""

# App URL (used for QR codes, email links, social sharing meta tags)
# Use the public URL the app will be accessed at — auto-detected by install.sh
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port and bind address (PORT can be 3000, 3001, 8080, etc.)
PORT="3000"
HOSTNAME="0.0.0.0"

# Session secret — REQUIRED in production (HMAC for the admin_session cookie).
# Generate with: openssl rand -hex 32
# Anything missing, equal to "fallback-dev-secret-change-me", or all-zeroes
# will crash the app at boot when NODE_ENV=production.
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"

# Master encryption key — REQUIRED to read/write payment provider secrets
# stored in the database (Paramètres → Paiements). 32-byte hex string.
# Generate with: openssl rand -hex 32
# Rotating it invalidates stored ciphertexts; re-enter the creds in the UI.
MASTER_ENCRYPTION_KEY=""

# Rate limiting — optional. When both URL and TOKEN are set, rate limiting
# is backed by Upstash Redis (works across serverless instances). When
# unset, falls back to a per-instance in-memory map (best-effort, fine for
# dev; surfaces a warning in production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Organization (set during install)
ORG_NAME="My Company"
ORG_SLUG="my-company"

# Initial admin (used by seed script)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASS="change-me"
ADMIN_NAME="Admin"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# SMS (Twilio) - Optional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Demo data: set to "false" to skip seeding sample events
SEED_DEMO_DATA="true"
