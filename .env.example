# ============================================
# QualiEvents Configuration
# Generated by install.sh
# ============================================

# Deploy mode: "onpremise" or "saas"
DEPLOY_MODE="onpremise"

# Database
# On-premise (SQLite): DB_PROVIDER=sqlite, DATABASE_URL=file:./dev.db
# SaaS (PostgreSQL):   DB_PROVIDER=postgresql, DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# App URL (used for QR codes, email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session secret (auto-generated, 64-char hex)
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"

# Organization (set during install)
ORG_NAME="My Company"
ORG_SLUG="my-company"

# Initial admin (used by seed script)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASS="change-me"
ADMIN_NAME="Admin"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# SMS (Twilio) - Optional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Demo data: set to "false" to skip seeding sample events
SEED_DEMO_DATA="true"
