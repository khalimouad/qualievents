generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, pro, enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           Event[]
  users            AdminUser[]
  paymentSettings  PaymentSettings?
}

model PaymentSettings {
  id            String   @id @default(uuid())
  // single row for now; orgId nullable for the on-premise / single-tenant case
  orgId         String?  @unique
  org           Organization? @relation(fields: [orgId], references: [id])
  provider      String   @default("cinetpay")
  enabled       Boolean  @default(false)
  mode          String   @default("TEST") // "TEST" | "PRODUCTION"
  apiKeyEnc     String?
  siteIdEnc     String?
  secretKeyEnc  String?
  notifyUrl     String?
  returnUrl     String?
  currency      String   @default("XOF")
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

model Event {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  tagline      String?
  description  String
  date         DateTime
  endDate      DateTime?

  // Event archetype (drives default fields shown in the form):
  //   TRAINING_SEMINAR | CONFERENCE | WEBINAR | FORUM | WORKSHOP | NETWORKING | OTHER
  eventType    String   @default("CONFERENCE")

  // Delivery format. ONLINE events skip venue requirement and surface stream
  // info to attendees; HYBRID has both physical + remote.
  format       String   @default("IN_PERSON") // IN_PERSON | ONLINE | HYBRID

  // Rich content blocks shown on the public page
  objectives     String?
  targetAudience String?
  context        String?

  // Stream / virtual fields (used when format != IN_PERSON)
  platform           String?  // "Zoom" | "Teams" | "YouTube Live" | ...
  streamUrl          String?
  streamPasswordEnc  String?  // encrypted via src/lib/crypto.ts
  streamInstructions String?
  recordingUrl       String?

  // Physical location (still relevant for HYBRID)
  venue        String
  address      String
  city         String
  country      String
  latitude     Float?
  longitude    Float?

  heroImage    String?
  gallery      String[] @default([])
  themeColor   String?
  maxAttendees Int      @default(500)
  isPublished  Boolean  @default(false)
  isPaid       Boolean  @default(false)
  ticketPrice  Int?     // Price in XOF (CFA francs)
  currency     String   @default("XOF")
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscribers  Subscriber[]
  panelists    Panelist[]
  badges       Badge[]
  invitations  Invitation[]
  newsletters  Newsletter[]
  sponsors     Sponsor[]
  payments     Payment[]
  infoRequests InfoRequest[]
  sessions     EventSession[]
}

/// Day-by-day program block (module, workshop, break, networking, …)
model EventSession {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// SESSION | WORKSHOP | BREAK | VISIT | DINNER | NETWORKING | EXAM
  kind        String   @default("SESSION")
  day         Int      @default(1)
  startTime   String?  // "09:00"
  endTime     String?  // "12:30"
  location    String?  // "Salle A" — useful in big venues
  speakerName String?  // free-form; can be a Panelist's full name
  streamUrl   String?  // override per-session (rare)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InfoRequest {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  message   String?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Subscriber {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  company     String?
  jobTitle    String?
  dietaryReqs String?
  status      String   @default("pending")
  paymentId   String?
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badge       Badge?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email, eventId])
}

model Payment {
  id              String   @id @default(uuid())
  transactionId   String?  @unique // CinetPay transaction ID
  amount          Int      // Amount in XOF
  currency        String   @default("XOF")
  status          String   @default("pending") // pending, completed, failed, refunded
  method          String?  // ORANGE_MONEY, MTN_MOBILE_MONEY, WAVE, MOOV, VISA
  payerPhone      String?
  payerName       String?
  payerEmail      String?
  cinetpayPayId   String?  // CinetPay payment_token
  metadata        String?  // JSON string for extra data
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscribers     Subscriber[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Panelist {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  bio       String?
  company   String?
  jobTitle  String?
  photo     String?
  topic     String?
  linkedin  String?
  twitter   String?
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Badge {
  id           String   @id @default(uuid())
  code         String   @unique
  qrData       String
  subscriberId String   @unique
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isScanned    Boolean  @default(false)
  scannedAt    DateTime?
  createdAt    DateTime @default(now())
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  phone     String?
  name      String
  type      String   @default("email")
  status    String   @default("pending")
  sentAt    DateTime?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(uuid())
  subject   String
  content   String
  status    String   @default("draft")
  sentAt    DateTime?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sponsor {
  id       String @id @default(uuid())
  name     String
  logo     String?
  website  String?
  tier     String @default("gold")
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sortOrder Int   @default(0)
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("staff") // admin, staff
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  createdAt    DateTime @default(now())
}
