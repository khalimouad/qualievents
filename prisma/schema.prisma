generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, pro, enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           Event[]
  users            AdminUser[]
  paymentSettings  PaymentSettings?
  series           EventSeries[]
}

model PaymentSettings {
  id            String   @id @default(uuid())
  // single row for now; orgId nullable for the on-premise / single-tenant case
  orgId         String?  @unique
  org           Organization? @relation(fields: [orgId], references: [id])
  provider      String   @default("cinetpay")
  enabled       Boolean  @default(false)
  mode          String   @default("TEST") // "TEST" | "PRODUCTION"
  apiKeyEnc     String?
  siteIdEnc     String?
  secretKeyEnc  String?
  notifyUrl     String?
  returnUrl     String?
  currency      String   @default("XOF")
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

model Event {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  tagline      String?
  description  String
  date         DateTime
  endDate      DateTime?

  // Event archetype (drives default fields shown in the form):
  //   TRAINING_SEMINAR | CONFERENCE | WEBINAR | FORUM | WORKSHOP | NETWORKING | OTHER
  eventType    String   @default("CONFERENCE")

  // Delivery format. ONLINE events skip venue requirement and surface stream
  // info to attendees; HYBRID has both physical + remote.
  format       String   @default("IN_PERSON") // IN_PERSON | ONLINE | HYBRID

  // Rich content blocks shown on the public page
  objectives     String?
  targetAudience String?
  context        String?

  // Stream / virtual fields (used when format != IN_PERSON)
  platform           String?  // "Zoom" | "Teams" | "YouTube Live" | ...
  streamUrl          String?
  streamPasswordEnc  String?  // encrypted via src/lib/crypto.ts
  streamInstructions String?
  recordingUrl       String?

  // Physical location (still relevant for HYBRID)
  venue        String
  address      String
  city         String
  country      String
  latitude     Float?
  longitude    Float?

  heroImage    String?
  gallery      String[] @default([])
  themeColor   String?
  maxAttendees Int      @default(500)
  isPublished  Boolean  @default(false)
  isPaid       Boolean  @default(false)
  ticketPrice  Int?     // Price in XOF (CFA francs)
  currency     String   @default("XOF")
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  seriesId     String?
  series       EventSeries?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  brochureUrl  String?  // optional PDF (programme brochure, plan d'accès…)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscribers  Subscriber[]
  panelists    Panelist[]
  badges       Badge[]
  invitations  Invitation[]
  newsletters  Newsletter[]
  sponsors     Sponsor[]
  payments     Payment[]
  infoRequests InfoRequest[]
  sessions     EventSession[]
  ticketTiers  EventTicketTier[]
  certifications Certification[]
  documents    EventDocument[]
  groupBookings GroupBooking[]
}

/// One transaction that registers several attendees at once.
/// Useful for B2B: an HR director registers 5 employees in one go, gets one
/// invoice. Each Subscriber row created from this booking carries the same
/// groupBookingId so the admin can group/list them.
model GroupBooking {
  id             String   @id @default(uuid())
  reference      String   @unique
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierId         String?
  tier           EventTicketTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  payerName      String
  payerEmail     String
  payerPhone     String?
  companyName    String?
  vatNumber      String?
  billingAddress String?
  totalAmount    Int      @default(0)
  currency       String   @default("EUR")
  status         String   @default("pending") // pending | confirmed | cancelled | refunded
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  invoiceUrl     String?
  invoiceNumber  String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscribers    Subscriber[]
}

/// Downloadable documents attached to an event (programme PDF, plan d'accès,
/// fiche logistique, conditions générales, etc.). The URL is whatever the
/// admin uploads or types in — typically a Vercel Blob URL after using the
/// existing /api/upload route, but external URLs are fine too.
model EventDocument {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// PROGRAMME | BROCHURE | LOGISTICS | TERMS | OTHER
  kind      String   @default("OTHER")
  title     String
  url       String
  sizeBytes Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A programme that groups several events under one umbrella — e.g.
/// "QUALI CONNECT 2026" (12 séminaires across 11 cities).
model EventSeries {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  heroImage   String?
  brochureUrl String?
  themeColor  String?
  isPublished Boolean  @default(false)
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      Event[]
}

/// Day-by-day program block (module, workshop, break, networking, …)
model EventSession {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  /// SESSION | WORKSHOP | BREAK | VISIT | DINNER | NETWORKING | EXAM
  kind        String   @default("SESSION")
  day         Int      @default(1)
  startTime   String?  // "09:00"
  endTime     String?  // "12:30"
  location    String?  // "Salle A" — useful in big venues
  speakerName String?  // free-form; can be a Panelist's full name
  streamUrl   String?  // override per-session (rare)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Issued certificate for a participant of an event.
/// Two flavours:
///   PARTICIPATION — attestation de participation (everyone who attended)
///   CERTIFIED     — examen réussi / certifying course (Lead Implementer, Risk Manager, …)
/// Each row carries a verificationCode that's printed (and QR-encoded) on the
/// PDF so anyone can confirm authenticity at /verify/<code>.
model Certification {
  id               String     @id @default(uuid())
  eventId          String
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscriberId     String     @unique
  subscriber       Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  type             String     @default("PARTICIPATION") // PARTICIPATION | CERTIFIED
  examPassed       Boolean?
  pdfUrl           String?
  verificationCode String     @unique
  issuedAt         DateTime?
  revoked          Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

/// A pricing tier on a paid event — "Standard", "Early bird", "Group 3+", etc.
/// The brochure for QUALI CONNECT lists 12 different prices, each bundling the
/// same kind of inclusions (5 nuitées B&B, transferts, mallette, certification…),
/// so we keep `inclusions` as a free-form list of bullets the admin can edit.
model EventTicketTier {
  id              String    @id @default(uuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Int                    // minor units (e.g. 3500 EUR -> 350000)
  currency        String    @default("EUR")
  inclusions      String[]  @default([])
  capacity        Int?                   // null = unlimited; counted vs Subscriber.tierId
  available       Boolean   @default(true)
  availableFrom   DateTime?
  availableUntil  DateTime?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscribers     Subscriber[]
  payments        Payment[]
  groupBookings   GroupBooking[]
}

model InfoRequest {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  company   String?
  message   String?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Subscriber {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  company     String?
  jobTitle    String?
  dietaryReqs String?
  status      String   @default("pending")
  unsubscribed Boolean  @default(false)
  paymentId   String?
  tierId      String?
  groupBookingId String?
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badge       Badge?
  payment     Payment? @relation(fields: [paymentId], references: [id])
  tier        EventTicketTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  groupBooking GroupBooking? @relation(fields: [groupBookingId], references: [id], onDelete: SetNull)
  certification Certification?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email, eventId])
}

model Payment {
  id              String   @id @default(uuid())
  transactionId   String?  @unique // CinetPay transaction ID
  amount          Int      // Amount in XOF
  currency        String   @default("XOF")
  status          String   @default("pending") // pending, completed, failed, refunded
  method          String?  // ORANGE_MONEY, MTN_MOBILE_MONEY, WAVE, MOOV, VISA
  payerPhone      String?
  payerName       String?
  payerEmail      String?
  cinetpayPayId   String?  // CinetPay payment_token
  metadata        String?  // JSON string for extra data
  tierId          String?
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tier            EventTicketTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  subscribers     Subscriber[]
  groupBookings   GroupBooking[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Panelist {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  bio       String?
  company   String?
  jobTitle  String?
  photo     String?
  topic     String?
  linkedin  String?
  twitter   String?
  eventId   String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Badge {
  id           String   @id @default(uuid())
  code         String   @unique
  badgeNumber  Int      @default(0)
  qrData       String
  subscriberId String   @unique
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  isScanned    Boolean  @default(false)
  scannedAt    DateTime?
  createdAt    DateTime @default(now())
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  phone     String?
  name      String
  type      String   @default("email")
  status    String   @default("pending")
  sentAt    DateTime?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Newsletter {
  id        String   @id @default(uuid())
  subject   String
  content   String
  status    String   @default("draft")
  sentAt    DateTime?
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  jobs      NewsletterJob[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Dispatch job for sending a Newsletter to confirmed subscribers in chunks.
/// Avoids serverless timeouts on big lists — each "tick" of /api/newsletter-jobs/[id]/process
/// processes one chunk and advances the cursor; the client polls until status=completed.
/// Stalled jobs (no progress for >5 min while running) are picked back up by the cron.
model NewsletterJob {
  id              String   @id @default(uuid())
  newsletterId    String
  newsletter      Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  status          String   @default("pending") // pending | running | completed | failed
  totalRecipients Int      @default(0)
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  cursor          Int      @default(0)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  lastTickAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, lastTickAt])
}

model Sponsor {
  id       String @id @default(uuid())
  name     String
  logo     String?
  website  String?
  tier     String @default("gold")
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sortOrder Int   @default(0)
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("staff") // admin, staff
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  createdAt    DateTime @default(now())
}

/// Append-only log of admin actions and security-relevant events.
/// Powers the audit trail in /admin/audit.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?           // AdminUser.id; null for system / public events
  actorEmail String?           // duplicated to survive admin deletion
  action     String            // dot-namespaced: "event.delete", "user.create", "payment.settings.update", …
  resource   String?           // human-readable target: "Event:contactexpo", "User:abc-…"
  metadata   String?           // JSON blob of useful context, when relevant
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}
